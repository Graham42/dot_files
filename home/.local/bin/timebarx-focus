#!/usr/bin/env bash
# Start a TimeBarX timer and stop Spotify 2s after it ends.
# Usage: timer <minutes> [message]

set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "Usage: timer <minutes> [message]" >&2
    exit 1
fi

minutes="$1"
message="${2:-}"
seconds=$(( minutes * 60 ))

if ! [[ "$minutes" =~ ^[0-9]+$ ]] || [[ "$minutes" -le 0 ]]; then
    echo "Error: minutes must be a positive integer" >&2
    exit 1
fi

# Start TimeBarX timer via URL scheme
if [[ -n "$message" ]]; then
    encoded_message=$(python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))" "$message")
    open "timebar://start?duration=${seconds}&message=${encoded_message}"
else
    open "timebar://start?duration=${seconds}"
fi

# Background: wait for the timer, then stop Spotify
(
    sleep "$seconds"
    sleep 2
    osascript -e 'tell application "Spotify" to pause' 2>/dev/null || true
) &

echo "Timer started: ${minutes}m${message:+ — $message}"
